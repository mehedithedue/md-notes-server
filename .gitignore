# ---------------------------------------------------------------------------
# md-notes-server .gitignore
#
# Only the tooling is versioned: the Python scripts, requirements.txt,
# README.md and LICENSE. The notes themselves (.md), every rendered page
# (.html), the static build and downloaded assets stay local.
# ---------------------------------------------------------------------------

# --- Content: notes and rendered pages -------------------------------------
# Every Markdown note except the project README.
*.md
!README.md
# Every rendered / hand-written HTML page (index.html, sample.html included).
*.html

# --- Build output and downloaded assets ------------------------------------
# build_site.py output (static copy for S3). Fully regenerable.
_site/
# serve.py --fetch-assets output: fonts, mermaid.min.js, highlight.min.js.
assets/
# Any other generated search index / export dropped at the root.
search.json

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets / local config -------------------------------------------------
.env
.env.*
.envrc
# Per-machine Claude Code permissions (settings.json, if ever added, is shared).
.claude/settings.local.json

# --- Editors and OS ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# --- Logs and temp files -----------------------------------------------------
*.log
*.tmp
*.bak
*.orig
scratch/
